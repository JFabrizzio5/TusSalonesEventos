{
  "info": {
    "name": "TusSalonesEventos API",
    "description": "Colección de endpoints para el sistema de gestión de eventos y calendarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:80",
      "type": "string"
    },
    {
      "key": "app_id",
      "value": "app-a",
      "type": "string"
    },
    {
      "key": "userauth_id",
      "value": "user-a",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Event Types",
      "item": [
        {
          "name": "List Event Types",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/event-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "event-types"]
            },
            "header": []
          },
          "response": []
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/events?app_id={{app_id}}&userauth_id={{userauth_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {"key": "app_id", "value": "{{app_id}}"},
                {"key": "userauth_id", "value": "{{userauth_id}}"}
              ]
            },
            "header": []
          },
          "response": []
        },
        {
