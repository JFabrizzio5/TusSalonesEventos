          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/calendar/week?app_id={{app_id}}&userauth_id={{userauth_id}}&week_start=2026-05-11",
              "host": ["{{baseUrl}}"],
              "path": ["api", "calendar", "week"],
              "query": [
                {"key": "app_id", "value": "{{app_id}}"},
                {"key": "userauth_id", "value": "{{userauth_id}}"},
                {"key": "week_start", "value": "2026-05-11"}
              ]
            },
            "header": []
          },
          "response": []
